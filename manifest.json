{
  "manifest_version": 3,
  "name": "鱼灾屏蔽助手",
  "version": "2.3.1",
  "description": "过滤 B 站和小黑盒评论中的低等级或指定关键词内容。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.bilibili.com/*", "https://www.xiaoheihe.cn/*"],
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/bangumi/*", "https://www.xiaoheihe.cn/app/bbs/link/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "鱼灾屏蔽助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
